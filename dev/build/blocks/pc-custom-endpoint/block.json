      "type": "string"
    },
    "selectedPostExcerpt": {
      "type": "string"
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "imports-dev-pc-custom-endpoint",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}